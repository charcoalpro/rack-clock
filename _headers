/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  X-Frame-Options: DENY
  Permissions-Policy: geolocation=(), camera=(), microphone=(), payment=()
  Content-Security-Policy: default-src 'none'; script-src 'self' 'unsafe-inline'; worker-src 'self'; style-src 'unsafe-inline'; img-src data:; manifest-src 'self'; connect-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'

# The shell carries the app, so it must revalidate or users get stuck on an old
# build. Cloudflare still holds it at the edge; the browser just re-checks.
/
  Cache-Control: public, max-age=0, must-revalidate
  CDN-Cache-Control: public, max-age=604800

/index.html
  Cache-Control: public, max-age=0, must-revalidate
  CDN-Cache-Control: public, max-age=604800

# Never cache the worker itself, or a broken release becomes permanent.
/sw.js
  Cache-Control: no-cache, must-revalidate
  Service-Worker-Allowed: /

/manifest.json
  Cache-Control: public, max-age=3600
  CDN-Cache-Control: public, max-age=604800

# Fingerprinted assets, if you ever add any (app.a1b2c3.css).
/assets/*
  Cache-Control: public, max-age=31536000, immutable

/*.svg
  Cache-Control: public, max-age=31536000, immutable

/*.png
  Cache-Control: public, max-age=31536000, immutable

/*.woff2
  Cache-Control: public, max-age=31536000, immutable
